{
  "$defs": {
    "SimulationDate": {
      "properties": {
        "year": {
          "maximum": 999999,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        },
        "month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "month"
      ],
      "title": "SimulationDate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "world_id": {
      "format": "uuid",
      "title": "World Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_type": {
