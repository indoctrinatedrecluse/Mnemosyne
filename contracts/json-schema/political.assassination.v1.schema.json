      "title": "Event Type",
      "type": "string"
    },
    "simulation_date": {
      "$ref": "#/$defs/SimulationDate"
    },
    "source_entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Entity Id"
    },
    "target_character_id": {
      "format": "uuid",
      "title": "Target Character Id",
      "type": "string"
    },
    "severity": {
      "maximum": 10,
      "minimum": 1,
      "title": "Severity",
      "type": "integer"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "world_id",
    "schema_version",
    "event_type",
    "simulation_date",
    "target_character_id",
    "severity"
