# Local development only. Copy to .env and replace values before any hosted use.
POSTGRES_DB=mnemosyne
POSTGRES_USER=mnemosyne
POSTGRES_PASSWORD=local-dev-change-me

# NiFi single-user account for local development only.
NIFI_USERNAME=mnemosyne-admin
NIFI_PASSWORD=local-dev-nifi-change-me-please
NIFI_SENSITIVE_PROPS_KEY=local-development-sensitive-properties-key

# API database URL used by Docker Compose.
DATABASE_URL=postgresql+psycopg://mnemosyne:local-dev-change-me@postgres:5432/mnemosyne
